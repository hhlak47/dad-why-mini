.container {
  padding: 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.subtitle {
  font-size: 26rpx;
  color: #888;
  margin-top: 12rpx;
}
.role-tabs {
  display: flex;
  gap: 24rpx;
  margin: 40rpx 0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  background: #f2f3f5;
  color: #555;
  font-size: 30rpx;
}
.tab.active {
  background: #07c160;
  color: #fff;
  font-weight: 600;
}
.guide-card {
  background: #fafafa;
  border-radius: 16rpx;
  padding: 28rpx;
  border: 1px solid #eee;
}
.guide-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.guide-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: #333;
}
.rec-btn {
  margin-top: 48rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
}
.rec-btn.recording {
  background: #fa5151;
}
.rec-btn[disabled] {
  background: #c8c9cc;
}
.status {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #07c160;
  text-align: center;
}
.status.status-cloning {
  color: #ff9700;
}
.tip {
  margin-top: auto;
  padding-top: 40rpx;
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.8;
}
