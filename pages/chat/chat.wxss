.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.qbar {
  padding: 28rpx 40rpx;
  font-size: 34rpx;
  font-weight: 700;
  background: var(--card);
  border-bottom: 1rpx solid var(--line);
}

.messages {
  flex: 1;
  padding: 32rpx 32rpx 20rpx;
}

.bubble.child {
  background: var(--child-bubble);
  border-radius: 24rpx 24rpx 6rpx 24rpx;
  padding: 22rpx 26rpx;
  max-width: 82%;
  margin-left: auto;
  margin-bottom: 28rpx;
}

.bubble .who {
  display: block;
  font-size: 24rpx;
  color: var(--primary-deep);
  margin-bottom: 8rpx;
}

.bubble-text {
  font-size: 32rpx;
}

.answer-card {
  background: var(--card);
  border-radius: 26rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.04);
}

.answer-head {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.answer-text {
  font-size: 33rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.answer-tools {
  margin-top: 18rpx;
}

.copy {
  font-size: 26rpx;
  color: var(--primary-deep);
  border: 1rpx solid #FFD9C2;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.speak {
  font-size: 26rpx;
  color: var(--primary-deep);
  border: 1rpx solid #FFD9C2;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
}

.game-card {
  background: var(--game);
  border-radius: 26rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 28rpx;
  border: 2rpx dashed var(--primary);
}

.game-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary-deep);
}

.game-meta {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--sub);
}

.game-steps {
  margin-top: 18rpx;
}

.step {
  display: flex;
  margin-bottom: 14rpx;
}

.step-num {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.step-text {
  flex: 1;
  font-size: 31rpx;
  line-height: 1.6;
}

.game-q {
  margin-top: 14rpx;
  font-size: 30rpx;
  color: var(--primary-deep);
  font-weight: 600;
}

.loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  color: var(--sub);
  font-size: 30rpx;
}

.dot-spin {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid #FFD9C2;
  border-top-color: var(--primary);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.error-box {
  background: #FFF0F0;
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
  color: #C0392B;
  font-size: 30rpx;
}

.retry-btn {
  margin-top: 18rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 12rpx 40rpx;
}

.retry-btn::after { border: none; }

.follow-panel {
  background: var(--card);
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--line);
}

.follow-input {
  width: 100%;
  min-height: 120rpx;
  background: #FBF4EE;
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 31rpx;
}

.follow-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.ghost-btn {
  flex: 1;
  background: #F2EAE3;
  color: var(--text);
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
}

.ghost-btn::after { border: none; }

.primary-btn.sm {
  flex: none;
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 16rpx 48rpx;
}

.primary-btn.sm::after { border: none; }

.follow-hint {
  text-align: center;
  font-size: 26rpx;
  color: var(--sub);
  padding: 14rpx 0 0;
  background: var(--card);
}

.actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--card);
  border-top: 1rpx solid var(--line);
}

.act-btn {
  flex: 1;
  background: #FFF4EC;
  color: var(--primary-deep);
  border-radius: 20rpx;
  font-size: 27rpx;
  padding: 26rpx 8rpx;
  line-height: 1.3;
  border: 1rpx solid #FFE0CC;
}

.act-btn.game {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  border: none;
}

.act-btn[disabled] {
  opacity: 0.4;
}

.act-btn::after { border: none; }

.new-q {
  text-align: center;
  font-size: 28rpx;
  color: var(--sub);
  padding: 22rpx 0 30rpx;
  background: var(--card);
}

.voice-switch {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 18rpx 40rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--line);
}
.vs-label {
  font-size: 26rpx;
  color: var(--sub);
  margin-right: 4rpx;
}
.vs-chip {
  padding: 12rpx 28rpx;
  background: #f2f3f5;
  color: #555;
  border-radius: 999rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}
.vs-chip.active {
  background: #E8F8EE;
  color: #07c160;
  border-color: #07c160;
  font-weight: 600;
}
.vs-go {
  font-size: 26rpx;
  color: var(--primary-deep);
  padding: 12rpx 16rpx;
}
